# Otedama .gitignore
# Comprehensive exclusions for build artifacts, secrets, and environment-specific files.

# ============================================================================
# Secrets and sensitive data — NEVER commit these
# ============================================================================
*.key
*.pem
*.crt
*.p12
*.pfx
*.der
*.jks
*.keystore
*.env
.env
.env.*
!.env.example
secrets/
credentials/
*.secret
wallet.dat
*.wallet
config.yaml
config.yml
!config.yaml.example

# ============================================================================
# Build artifacts
# ============================================================================
build/
dist/
bin/
out/
/otedama
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.test
*.prof
*.trace
vendor/
.vendor/

# Release artifacts
*.tar.gz
*.zip
*.deb
*.rpm
*.msi
*.dmg
*.pkg
*.AppImage

# ============================================================================
# Go specific
# ============================================================================
# Test output
coverage.out
coverage.html
coverage.txt
*.cover
*.coverprofile
c.out

# Go workspace files
go.work
go.work.sum

# Go build cache
.cache/

# Go debug binaries
__debug_bin

# ============================================================================
# Development environment
# ============================================================================
# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*.swn
*~
.project
.settings/
*.sublime-workspace
*.sublime-project
.atom/
nbproject/

# Editor temporary files
*.orig
*.rej
*.bak
.#*
\#*\#

# ============================================================================
# OS specific
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msix
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ============================================================================
# Logs and runtime data
# ============================================================================
logs/
*.log
*.log.*
log/
otedama.pid
*.pid
*.seed
*.pid.lock

# ============================================================================
# Databases
# ============================================================================
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.db-journal

# ============================================================================
# Temporary files
# ============================================================================
tmp/
temp/
.tmp/
.temp/
*.tmp
*.temp

# ============================================================================
# Project-specific
# ============================================================================
# Profiling output (--pprof / benchstat workflows)
cpu.pprof
mem.pprof
trace.out
