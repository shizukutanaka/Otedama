# Otedama .gitignore
# Comprehensive exclusions for build artifacts, secrets, and environment-specific files.

# ============================================================================
# Secrets and sensitive data — NEVER commit these
# ============================================================================
*.key
*.pem
*.crt
*.p12
*.pfx
*.der
*.jks
*.keystore
*.env
.env
.env.*
!.env.example
secrets/
credentials/
*.secret
wallet.dat
*.wallet
config.yaml
config.yml
!config.yaml.example
!config.production.yaml

# Lightning Network channel and wallet data
channel.db
wallet.db
neutrino.db
chainstate.db
blocks.db
*.ldk
lnd.conf
ldk-node/

# Bitcoin Core data
blocks/
chainstate/
indexes/
peers.dat

# ============================================================================
# Build artifacts
# ============================================================================
build/
dist/
bin/
out/
/otedama
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.test
*.prof
*.trace
vendor/
.vendor/

# Release artifacts
*.tar.gz
*.zip
*.deb
*.rpm
*.msi
*.dmg
*.pkg
*.AppImage
SHA256SUMS*
!SHA256SUMS.example

# ============================================================================
# Go specific
# ============================================================================
# Test output
coverage.out
coverage.html
coverage.txt
*.cover
*.coverprofile
c.out

# Go workspace files
go.work
go.work.sum

# Go build cache
.cache/

# Go debug binaries
__debug_bin

# ============================================================================
# Development environment
# ============================================================================
# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*.swn
*~
.project
.settings/
*.sublime-workspace
*.sublime-project
.atom/
nbproject/

# Editor temporary files
*.orig
*.rej
*.bak
.#*
\#*\#

# ============================================================================
# OS specific
# ============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msix
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ============================================================================
# Logs and runtime data
# ============================================================================
logs/
*.log
*.log.*
log/
otedama.pid
*.pid
*.seed
*.pid.lock

# ============================================================================
# Databases
# ============================================================================
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.db-journal

# ============================================================================
# Temporary files
# ============================================================================
tmp/
temp/
.tmp/
.temp/
*.tmp
*.temp

# ============================================================================
# Documentation build output
# ============================================================================
docs/_build/
docs/build/
docs/.docusaurus/
site/
public/
.vuepress/dist/

# ============================================================================
# Node.js (for web/ directory)
# ============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.next/
.nuxt/

# ============================================================================
# Python (for scripts/ directory)
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/

# ============================================================================
# Docker and container artifacts
# ============================================================================
.docker/
docker-compose.override.yml
docker-compose.override.yaml

# ============================================================================
# Legacy v2 cleanup artifacts (will be removed post-reset)
# ============================================================================
fix_*.sh
remove_*.sh
*.bak.*

# ============================================================================
# Project-specific
# ============================================================================
# Mining work cache
work-cache/
share-cache/

# Hardware benchmark data
benchmark-results/
*.benchmark

# Profiling output
cpu.pprof
mem.pprof
trace.out
