# Otedama configuration file
# Place this file at: ~/.config/otedama/config.yaml
# Override with:      --config /path/to/config.yaml
#
# Every field is optional. The minimum viable configuration is either:
#   - This file with bitcoin_address set, or
#   - No file at all, with --bitcoin-address passed on the command line.
#
# Precedence (highest to lowest):
#   1. Command-line flags  (--bitcoin-address, --log-level, etc.)
#   2. Environment vars    (OTEDAMA_BITCOIN_ADDRESS, OTEDAMA_LOG_LEVEL, etc.)
#   3. This config file
#   4. Built-in defaults

# ── Wallet ──────────────────────────────────────────────────────────────────
#
# Your Bitcoin or Lightning address for receiving mining rewards.
# Accepted formats:
#   P2PKH  : starts with '1'
#   P2SH   : starts with '3'
#   Bech32 : starts with 'bc1'
#
bitcoin_address: ""

# Optional failover payout addresses. If the address above cannot be used
# to establish a mining session on any configured pool (e.g. a pool rejects
# it), Otedama rotates to the next address here, in order. Earnings only go
# to whichever address actually connects, and a working address is never
# abandoned for a transient pool/network problem — so an outage can never
# silently redirect your payouts. All entries are validated like the above.
# bitcoin_addresses:
#   - "bc1q...backup1..."
#   - "3...backup2..."

# ── Pools ────────────────────────────────────────────────────────────────────
#
# List of mining pools in order of preference. Otedama connects to the
# first and fails over to subsequent entries if the connection drops.
#
# If this list is empty, Otedama uses its built-in recommended pool list
# (Stratum V2 pools prioritised, 0% fee where available).
#
# Supported URL schemes:
#   stratum+v2://       Stratum V2 unencrypted  (LAN or trusted networks only)
#   stratum+v2tls://    Stratum V2 encrypted    (recommended for internet)
#   stratum+tls://      Stratum V1 encrypted
#   stratum+tcp://      Stratum V1 plain        (not recommended)
#
pools:
  - url: "stratum+v2tls://public.stratum.slushpool.com:3336"
    # user is optional; defaults to bitcoin_address.
    user: ""
    # password is optional; most pools accept any value.
    password: "x"
    # payout_scheme (optional) documents the pool's reward method so
    # `otedama doctor` can surface its trade-offs. It has NO effect on mining.
    # One of:
    #   fpps   — Full Pay Per Share: smooth payouts, pool absorbs variance
    #   pplns  — Pay Per Last N Shares: lower fee, miner absorbs variance
    #   tides  — OCEAN's non-custodial coinbase payout (best fit for Otedama)
    #   solo   — full block reward or nothing
    # payout_scheme: "tides"
    #
    # tls_ca_file (optional) is a path to a PEM bundle of extra certificate
    # authorities to trust for this pool's stratum+tls:// certificate, for a
    # pool presenting a private-CA or self-signed cert. System roots are always
    # used as well, and certificate verification is never disabled. No effect
    # on non-TLS schemes.
    # tls_ca_file: "/etc/otedama/pool-ca.pem"

  # Failover: list pools in priority order. Otedama tries the first;
  # if a connection fails or drops, it rotates to the next immediately,
  # and only applies reconnect backoff once every pool has been tried.
  # Uncomment to add a backup:
  # - url: "stratum+v2tls://demand.fun:3336"
  #   password: "x"

# ── Workers ──────────────────────────────────────────────────────────────────
workers:
  # Human-readable worker name sent to the pool for identification.
  # Defaults to the hostname if empty.
  name: ""

# ── Language ─────────────────────────────────────────────────────────────────
#
# BCP 47 language tag for UI messages and log output.
# Supported: en, ja, zh-CN, ko, es, fr, de, pt
# (Other tags are accepted and fall back to English.)
# If empty, Otedama detects the language from the operating system.
#
language: ""

# ── Logging ──────────────────────────────────────────────────────────────────
#
# Log level: debug | info | warn | error
# Default: info
#
log_level: "info"

# ── Data directory ───────────────────────────────────────────────────────────
#
# Directory where Otedama stores the Lightning wallet and usage data.
# Defaults:
#   Linux / BSD : $XDG_DATA_HOME/otedama   or  ~/.local/share/otedama
#   macOS       : ~/Library/Application Support/Otedama
#   Windows     : %APPDATA%\Otedama
#
data_dir: ""

# ── ASIC endpoints ────────────────────────────────────────────────────────────
#
# Standalone ASIC miners to detect via the cgminer-compatible RPC API
# (Antminer/bmminer, Whatsminer, Avalon, Braiins). Detection is opt-in
# per endpoint — Otedama never scans subnets — so miners must expose
# their management API (usually TCP 4028) to this host. Entries are
# "host:port"; a bare host implies the default API port 4028.
#
# Detected ASICs appear in the device list and logs for inventory only —
# Otedama does not dispatch work to them yet (see docs/KNOWN_LIMITATIONS.md §8).
#
# asic_endpoints:
#   - "192.168.1.50"         # implies :4028
#   - "whatsminer.lan:4028"
#
# asic_manage lets the detected miners *follow* Otedama's active pool:
# every time the engine connects (including failover), the same pool is
# pushed onto each managed miner via the cgminer addpool + switchpool
# commands, so a small fleet mines where Otedama does. Default false —
# the commands rewrite each miner's live pool table, so actuation is
# strictly opt-in even though detection already probes those hosts.
# Only Stratum-V1-compatible URLs are pushed (cgminer firmwares speak
# SV1; datum:// is rewritten to stratum+tcp://); V2 URLs are skipped.
# Requires asic_endpoints to name the miners to manage.
#
# asic_manage: false

# ── HTTP endpoints ────────────────────────────────────────────────────────────
#
# Address for Prometheus metrics and health endpoints.
# Leave empty to disable (default).
#
# Endpoints exposed when set:
#   GET /metrics   — Prometheus text exposition format
#   GET /healthz   — liveness probe (always 200 when server is alive)
#   GET /readyz    — readiness probe (200 when engine is mining, 503 otherwise)
#   GET /          — HTML landing page
#
# Security note: bind to 127.0.0.1 (loopback) unless you have a reverse proxy
# with authentication in front. The metrics endpoint is unauthenticated.
#
# http_addr: "127.0.0.1:9090"

# ── Log format ───────────────────────────────────────────────────────────────
#
# Output format for log messages.
#   text   — Human-readable, coloured (default)
#   json   — Structured JSON (recommended for log aggregation tools)
#
log_format: "text"

# ── Profitability & power ─────────────────────────────────────────────────────
#
# curtail_below_btc_usd pauses ALL hashing when the BTC/USD rate falls below
# this threshold (USD), so you stop mining at a loss during a price crash;
# hashing resumes automatically once the price recovers. It acts only on a
# fresh, trusted price — never on the startup fallback or a stale rate — so it
# cannot pause or resume mining on a price it does not trust.
# 0 (default) disables curtailment.
# curtail_below_btc_usd: 0

# curtail_above_uk_carbon pauses ALL hashing when the UK National Grid's
# carbon-intensity forecast rises above this threshold (gCO2/kWh), so GB
# operators can stop mining during dirty grid windows (SUSTAINABILITY.md);
# hashing resumes automatically once intensity recovers. The source
# (api.carbonintensity.org.uk, no key needed) covers the GB grid only —
# it says nothing about other grids, which is why the name carries the
# region. Like the price gate it acts only on a fresh reading: a failed
# fetch never pauses or resumes mining. 0 (default) disables curtailment.
# curtail_above_uk_carbon: 0

# curtail_above_tariff_pence pauses ALL hashing when the current Octopus
# Agile slot price rises above this threshold (pence/kWh, VAT-inclusive),
# so GB operators on a time-of-use tariff can stop mining during price
# spikes; hashing resumes automatically once the slot price recovers. It
# reads the same electricity_tariff_octopus feed that publishes
# otedama_electricity_tariff_pence_per_kwh — set electricity_tariff_octopus
# as well or the gate has no data. Like the other gates it acts only on a
# fresh slot reading: a failed fetch never pauses or resumes mining.
# 0 (default) disables curtailment.
# curtail_above_tariff_pence: 0

# min_yield_sats_per_sec is a per-device profitability floor (satoshis/second):
# the arbitration engine leaves a device idle when none of its compatible
# revenue streams clears this rate, instead of running it for a trickle of
# revenue that does not justify the power, wear, and heat. It complements
# curtail_below_btc_usd — that pauses ALL hashing on a global BTC price, while
# this idles only the individual weak devices on a mixed rig.
# 0 (default) disables the floor: every positive-yield stream qualifies.
# min_yield_sats_per_sec: 0

# income_mode selects the arbitration decision criterion (ADR-010 A5):
#   "max"      (default) picks the highest expected yield every cycle;
#   "smooth"   picks the highest modified Sharpe ratio — (yield minus the
#              min_yield floor) over the realized-yield standard deviation —
#              preferring steady income over equal-but-spiky quotes;
#   "balanced" scores candidates 0.5 x normalized-yield + 0.5 x
#              normalized-Sharpe across each device's candidate set.
# A stream with no volatility history yet scores Sharpe 0 under smooth —
# unproven risk counts as maximal risk, so smooth mode prefers proven
# steady streams until enough quotes have arrived to measure the rest.
# income_mode: "max"

# power_watts is your rig's measured total power draw, in watts. Setting it
# enables the energy-efficiency metric otedama_joules_per_terahash.
# 0 (default) leaves the efficiency/cost metrics off.
# power_watts: 0

# electricity_price_per_kwh is your electricity cost in USD per kWh. Combined
# with power_watts it enables otedama_power_cost_usd_per_hour — the cost side of
# net profit. 0 (default) leaves it unset.
# electricity_price_per_kwh: 0

# thermal_throttle_above_celsius pauses ALL hashing when the hottest OS-reported
# temperature sensor (Linux hwmon: CPU zones like k10temp/coretemp, amdgpu
# edge/junction, nvme composite) reaches this value — the safety counterpart of
# curtail_below_btc_usd's economic pause. Hashing resumes once the hottest sensor
# cools 5 °C below the threshold. Valid range [20, 110]; 0 (default) disables the
# gate. Sensor readings are always exported as otedama_thermal_sensor_celsius
# when metrics are on; on macOS/Windows (no hwmon) the gate sees no data and
# simply stays off.
# thermal_throttle_above_celsius: 0

# electricity_tariff_octopus names an Octopus Energy tariff as
# "PRODUCT/TARIFF" (e.g. "AGILE-24-10-01/E-1R-AGILE-24-10-01-A" for Agile).
# When set, Otedama polls the keyless half-hourly unit-rate API every 15 min
# and publishes the current price on otedama_electricity_tariff_pence_per_kwh —
# the feed is in GB pence/kWh, which is why it is a separate field from the
# USD-denominated electricity_price_per_kwh above. Groundwork for
# tariff-aware scheduling (ADR-008). "" (default) disables the feed.
# electricity_tariff_octopus: ""

# worker_threads caps the SHA-256d hashing goroutines each miner worker spawns.
# 0 (default) means auto — one goroutine per logical CPU. Pin a small positive
# integer on machines that must stay responsive while mining (laptops, shared
# hosts); integer in [0, 1024]. Also settable via --worker-threads or
# OTEDAMA_WORKER_THREADS.
# worker_threads: 0

# ── Arbitration ───────────────────────────────────────────────────────────────
#
# arbitration_hysteresis_pct is the minimum fractional yield improvement a
# competing revenue stream must beat the current assignment by before Otedama
# switches to it. It damps rapid flapping between near-equal streams. Range
# [0.0, 1.0); 0.05 (default) requires a 5% improvement to switch. A value of 0
# switches on any improvement; higher values leave more yield on the table for
# greater stability (see otedama_arbitration_holds_total / _foregone_sats_per_second).
# arbitration_hysteresis_pct: 0.05
