# Otedama P2P Mining Pool v2.1.9
# Environment Variables Configuration
# Copy this file to .env and configure

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# Database
DATABASE_DRIVER=sqlite3
DATABASE_URL=./data/otedama.db

# API Configuration
API_ADDRESS=:8080
API_SSL_ADDRESS=
API_CERT_FILE=
API_KEY_FILE=

# Mining Configuration
MINING_ALGORITHM=sha256d
MINING_POOL=stratum+tcp://pool.example.com:3333
MINING_WALLET=YOUR_WALLET_ADDRESS
MINING_WORKER=otedama

# P2P Configuration
P2P_PORT=18555
P2P_BOOTSTRAP=

# Monitoring
METRICS_PORT=9090
HEALTH_PORT=8081

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/otedama.log

# Performance
GOMAXPROCS=0
GOGC=50

# Feature Flags
ENABLE_P2P=false
ENABLE_API=true
ENABLE_MONITORING=true
ENABLE_AUTO_TUNING=true

# Development
DEBUG=false
